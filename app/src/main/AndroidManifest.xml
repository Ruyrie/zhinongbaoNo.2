<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZhiNongBao">

        <!-- 登录（启动页） -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 注册 / 添加账号 -->
        <activity android:name=".activity.RegisterActivity" />

        <!-- 主界面 -->
        <activity
            android:name=".activity.MainActivity"
            android:windowSoftInputMode="adjustPan" />

        <!-- 文章详情（adjustResize 让底部评论栏随键盘上移） -->
        <activity
            android:name=".activity.ArticleDetailActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 我的收藏（文章） -->
        <activity android:name=".activity.MyFavoritesActivity" />

        <!-- 商品收藏 -->
        <activity android:name=".activity.ProductFavoritesActivity" />

        <!-- 聊天 -->
        <activity
            android:name=".activity.ChatActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 我的足迹 -->
        <activity android:name=".activity.FootprintActivity" />

        <!-- 粉丝 / 关注列表 -->
        <activity android:name=".activity.FollowListActivity" />

        <!-- 搜索 -->
        <activity
            android:name=".activity.SearchActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 商品搜索 -->
        <activity
            android:name=".activity.ProductSearchActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 商品详情 -->
        <activity android:name=".activity.ProductDetailActivity" />

        <!-- 购物车 -->
        <activity android:name=".activity.CartActivity" />

        <!-- 我的文章 -->
        <activity android:name=".activity.MyArticlesActivity" />

        <!-- 我的订单 -->
        <activity android:name=".activity.MyOrdersActivity" />

        <!-- 设置 -->
        <activity android:name=".activity.SettingsActivity" />

        <!-- 账号管理 -->
        <activity android:name=".activity.AccountManagerActivity" />

        <!-- 地址管理 -->
        <activity android:name=".activity.AddressManagerActivity" />

        <!-- 修改密码 -->
        <activity android:name=".activity.ChangePasswordActivity" />

        <!-- 忘记密码 -->
        <activity android:name=".activity.ForgotPasswordActivity" />

        <!-- 重置密码 -->
        <activity android:name=".activity.ResetPasswordActivity" />

        <!-- 添加文章（管理员） -->
        <activity android:name=".activity.AddArticleActivity" />

        <!-- 添加商品（管理员） -->
        <activity android:name=".activity.AddProductActivity" />

        <!-- 订单详情 -->
        <activity android:name=".activity.OrderDetailActivity" />

        <!-- 编辑资料 -->
        <activity android:name=".activity.ProfileEditActivity" />

        <!-- 商品评价列表 -->
        <activity android:name=".activity.ProductCommentsActivity" />

        <!-- 发表商品评价 -->
        <activity android:name=".activity.AddProductCommentActivity" />

        <!-- 发农友圈动态 -->
        <activity
            android:name=".activity.AddCirclePostActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 我的动态 -->
        <activity android:name=".activity.MyCirclePostsActivity" />

        <!-- 卖家店铺 -->
        <activity android:name=".activity.SellerStoreActivity" />

        <!-- 发布采购需求 -->
        <activity
            android:name=".activity.PostPurchaseActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 采购市场 -->
        <activity android:name=".activity.PurchaseMarketActivity" />

        <!-- 卖家：我的货品 -->
        <activity android:name=".activity.SellerMyProductsActivity" />

        <!-- 卖家：采购管理 -->
        <activity android:name=".activity.SellerPurchaseMgmtActivity" />

        <!-- 卖家：订单管理 -->
        <activity android:name=".activity.SellerOrdersActivity" />

        <!-- 卖家：销售流水分析 -->
        <activity android:name=".activity.SellerSalesAnalysisActivity" />

        <!-- uCrop 裁剪 Activity（子类，用于正确处理 Android 16 edge-to-edge insets） -->
        <activity
            android:name=".activity.UCropCompatActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.UCrop"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".provider.ZhiNongBaoProvider"
            android:authorities="com.example.zhinongbao.provider"
            android:exported="false" />

    </application>

</manifest>
