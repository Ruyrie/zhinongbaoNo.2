<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#DDF4E5" />
            <stroke android:width="1dp" android:color="#24B34D" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#FFFFFF"
                android:centerColor="#F5FFF7"
                android:endColor="#E7F8EC" />
            <stroke android:width="1dp" android:color="#DCEFE2" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
