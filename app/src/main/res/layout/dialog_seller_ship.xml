<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_round_24"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="订单发货"
        android:textColor="#111827"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="请填写完整发货信息，买家将在订单详情中查看物流。"
        android:textColor="#8A8F98"
        android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="发货方式"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/rgShipType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbExpress"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_input"
                android:buttonTint="#43A047"
                android:gravity="center"
                android:text="标准快递"
                android:textColor="#111827"
                android:textSize="14sp"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbCustom"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_input"
                android:buttonTint="#43A047"
                android:gravity="center"
                android:textColor="#111827"
                android:textSize="14sp"
                android:text="自定义货运"/>
        </RadioGroup>

        <!-- 标准快递输入区 -->
        <LinearLayout
            android:id="@+id/llExpressInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="15dp">

            <EditText
                android:id="@+id/etExpressCompany"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="快递公司（如：顺丰、中通）"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/etExpressNo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:hint="快递单号"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- 自定义货运输入区 -->
        <LinearLayout
            android:id="@+id/llCustomInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="15dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etDriverName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="司机姓名"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/etCarNo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:hint="车牌号"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/etDriverPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:hint="司机联系电话"
                android:inputType="phone"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:singleLine="true"/>
        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnShipCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_auth_input"
            android:gravity="center"
            android:text="取消"
            android:textColor="#43A047"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnShipConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_auth_green_button"
            android:gravity="center"
            android:text="确定发货"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
