<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发货方式"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/rgShipType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbExpress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="标准快递"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="自定义货运"/>
        </RadioGroup>

        <!-- 标准快递输入区 -->
        <LinearLayout
            android:id="@+id/llExpressInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="15dp">

            <EditText
                android:id="@+id/etExpressCompany"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="快递公司（如：顺丰、中通）"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/etExpressNo"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:hint="快递单号"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- 自定义货运输入区 -->
        <LinearLayout
            android:id="@+id/llCustomInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="15dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etDriverName"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="司机姓名"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/etCarNo"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:hint="车牌号"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/etDriverPhone"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:hint="司机联系电话"
                android:inputType="phone"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:singleLine="true"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>