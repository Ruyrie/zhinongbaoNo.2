<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- ── 顶部 Header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 农友圈 "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_circle_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <!-- 头像 + 我的（点击查看自己的动态） -->
            <LinearLayout
                android:id="@+id/llHeaderMine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">

                    <ImageView
                        android:id="@+id/ivHeaderAvatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_auth_logo"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvHeaderAvatarInitial"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_auth_logo" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我的"
                    android:textSize="13sp"
                    android:textColor="#4CAF50"
                    android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 自定义双 Tab（关注 / 最新）── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tabFollow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvTabFollow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="关注"
                        android:textSize="15sp"
                        android:textColor="#AAAAAA" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabLatest"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvTabLatest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最新"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A" />
                </LinearLayout>
            </LinearLayout>

            <!-- 下划线指示器 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp">

                <View
                    android:id="@+id/tabIndicator"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:background="#4CAF50" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#EEEEEE" />

        <!-- 帖子列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCircle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="90dp" />

        <!-- 空状态 -->
        <TextView
            android:id="@+id/tvCircleEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:lineSpacingMultiplier="1.6"
            android:textColor="#BBBBBB"
            android:textSize="15sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- FAB：与农技学堂保持一致 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCirclePost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="106dp"
        android:src="@drawable/ic_add_white"
        app:backgroundTint="#00d28a"
        app:tint="@color/white"
        app:elevation="4dp" />

</FrameLayout>
