<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:clipToPadding="false"
    android:paddingBottom="128dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Top white card (profile + quick actions) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_marginBottom="12dp">

            <!-- Avatar + username + bio + switch button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                
                <LinearLayout
                    android:id="@+id/layoutProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="12dp"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardCornerRadius="36dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/ivMineAvatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:background="@drawable/bg_auth_logo"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tvAvatarInitial"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_auth_logo"
                                    android:gravity="center"
                                    android:textSize="30sp"
                                    android:textColor="@color/white"
                                    android:textStyle="bold"
                                    android:text="我" />
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvMineNickname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#1F1F1F"
                            android:text="昵称" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMineUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#8A8A8A"
                        android:layout_marginTop="14dp"
                        android:text="用户名： " />

                    <TextView
                        android:id="@+id/tvMineSignature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#8A8A8A"
                        android:layout_marginTop="4dp"
                        android:text="点击编辑资料" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSwitchToSeller"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="104dp"
                    android:text="切换到卖家"
                    android:textSize="13sp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:background="@drawable/bg_role_switch_outline"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="#EBEBEB"
                android:layout_marginHorizontal="24dp" />

            <!-- Quick action row: 购物车 | 商品收藏 | 足迹 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:id="@+id/quickCart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:foreground="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@mipmap/gouwuche"
                        android:scaleType="fitCenter" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="购物车"
                        android:textSize="12sp"
                        android:textColor="#1F1F1F"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E5E5EA" />

                <LinearLayout
                    android:id="@+id/quickFavorites"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:foreground="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@mipmap/shoucang"
                        android:scaleType="fitCenter" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="商品收藏"
                        android:textSize="12sp"
                        android:textColor="#1F1F1F"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E5E5EA" />

                <LinearLayout
                    android:id="@+id/quickFootprint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:foreground="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:id="@+id/ivFootprintIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:scaleType="fitCenter" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="足迹"
                        android:textSize="12sp"
                        android:textColor="#1F1F1F"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── My Orders Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="16dp">

                <!-- Header row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="我的订单"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F" />

                    <TextView
                        android:id="@+id/tvAllOrders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全部订单 ›"
                        android:textSize="14sp"
                        android:textColor="#8A8A8A"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- Order status icons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:id="@+id/orderPending"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?attr/selectableItemBackgroundBorderless">
                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="30dp">

                            <ImageView
                                android:id="@+id/ivOrderPending"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/badgeOrderPending"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:minWidth="18dp"
                                android:minHeight="18dp"
                                android:gravity="center"
                                android:paddingHorizontal="5dp"
                                android:background="@drawable/bg_count_badge"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:visibility="gone" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="待付款"
                            android:textSize="11sp"
                            android:textColor="#555555"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/orderShipping"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?attr/selectableItemBackgroundBorderless">
                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="30dp">

                            <ImageView
                                android:id="@+id/ivOrderShipping"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/badgeOrderShipping"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:minWidth="18dp"
                                android:minHeight="18dp"
                                android:gravity="center"
                                android:paddingHorizontal="5dp"
                                android:background="@drawable/bg_count_badge"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:visibility="gone" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="待发货"
                            android:textSize="11sp"
                            android:textColor="#555555"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/orderReceiving"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?attr/selectableItemBackgroundBorderless">
                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="30dp">

                            <ImageView
                                android:id="@+id/ivOrderReceiving"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/badgeOrderReceiving"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:minWidth="18dp"
                                android:minHeight="18dp"
                                android:gravity="center"
                                android:paddingHorizontal="5dp"
                                android:background="@drawable/bg_count_badge"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:visibility="gone" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="待收货"
                            android:textSize="11sp"
                            android:textColor="#555555"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/orderReviewing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?attr/selectableItemBackgroundBorderless">
                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="30dp">

                            <ImageView
                                android:id="@+id/ivOrderReviewing"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/badgeOrderReviewing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:minWidth="18dp"
                                android:minHeight="18dp"
                                android:gravity="center"
                                android:paddingHorizontal="5dp"
                                android:background="@drawable/bg_count_badge"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:visibility="gone" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="待评价"
                            android:textSize="11sp"
                            android:textColor="#555555"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/orderRefund"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:foreground="?attr/selectableItemBackgroundBorderless">
                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="30dp">

                            <ImageView
                                android:id="@+id/ivOrderRefund"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/badgeOrderRefund"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:minWidth="18dp"
                                android:minHeight="18dp"
                                android:gravity="center"
                                android:paddingHorizontal="5dp"
                                android:background="@drawable/bg_count_badge"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:visibility="gone" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="退款/售后"
                            android:textSize="11sp"
                            android:textColor="#555555"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Stats row: 粉丝 | 关注 | 获赞 (moved from top) ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:id="@+id/statFollowers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:foreground="?attr/selectableItemBackgroundBorderless">
                    <TextView
                        android:id="@+id/tvStatFollowers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F"
                        android:text="0" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#8A8A8A"
                        android:layout_marginTop="2dp"
                        android:text="粉丝" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E5E5EA" />

                <LinearLayout
                    android:id="@+id/statFollowing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:foreground="?attr/selectableItemBackgroundBorderless">
                    <TextView
                        android:id="@+id/tvStatFollowing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F"
                        android:text="0" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#8A8A8A"
                        android:layout_marginTop="2dp"
                        android:text="关注" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E5E5EA" />

                <LinearLayout
                    android:id="@+id/statLikes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:foreground="?attr/selectableItemBackgroundBorderless">
                    <TextView
                        android:id="@+id/tvStatLikes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F"
                        android:text="0" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#8A8A8A"
                        android:layout_marginTop="2dp"
                        android:text="获赞" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Menu Card: 我的文章 / 我的收藏 ── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/tvMyArticles"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@mipmap/wenzhang" android:layout_marginEnd="14dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="我的文章" android:textSize="16sp" android:textColor="#1F1F1F" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="22sp" android:textColor="#C7C7CC" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="#F0F0F0" android:layout_marginStart="52dp" />

                <LinearLayout
                    android:id="@+id/tvMyFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@mipmap/shoucang" android:layout_marginEnd="14dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="文章收藏" android:textSize="16sp" android:textColor="#1F1F1F" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="22sp" android:textColor="#C7C7CC" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="#F0F0F0" android:layout_marginStart="52dp" />

                <LinearLayout
                    android:id="@+id/tvCircleFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@mipmap/shoucang" android:layout_marginEnd="14dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="农友圈点赞" android:textSize="16sp" android:textColor="#1F1F1F" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="22sp" android:textColor="#C7C7CC" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0.5dp"
                    android:background="#F0F0F0" android:layout_marginStart="52dp" />

                <LinearLayout
                    android:id="@+id/tvSettings"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@mipmap/shezhi" android:layout_marginEnd="14dp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="设置" android:textSize="16sp" android:textColor="#1F1F1F" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="22sp" android:textColor="#C7C7CC" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
