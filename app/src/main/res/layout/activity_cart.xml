<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     【购物车 / Cart】购物车整页布局（activity = 一整屏的样子）
     ============================================================
     这个文件是干什么的：
       它描述购物车「这一整屏」的界面骨架，自上而下分三块：
         1) 顶部标题栏：返回箭头 + “购物车” + 件数 + “清空”。
         2) 中间 RecyclerView（rvCart）：可滚动的商品列表，每行用 item_cart.xml。
         3) 底部结算栏：全选框 + 合计金额 + “去结算”按钮。

     概念说明：
       - 文件名以 activity_ 开头 = 一整个页面的布局，对应一个 Activity（这里是 CartActivity）。
       - 最外层竖排 LinearLayout 把三块从上到下叠起来。
       - 中间列表 height=0dp + layout_weight=1 = 「占满标题栏和底部栏之间的剩余空间」。
       - 控件的 id（如 @+id/btnCheckout）供 CartActivity 用 findViewById 找到并绑定点击。

     配套：由 CartActivity.setContentView 加载；列表单行是 item_cart.xml。
     提示：在 IDE 里搜索「购物车」可看本组全部文件。
     ============================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部标题栏：返回箭头 + 标题“购物车” + 件数(tvCartCount) + 清空(tvClearCart) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/tvBack"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/fanhui"
            android:scaleType="fitCenter"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="购物车"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1F1F1F" />

        <TextView
            android:id="@+id/tvCartCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#8A8A8A"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvClearCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空"
            android:textSize="14sp"
            android:textColor="#FF3B30"
            android:padding="4dp" />
    </LinearLayout>

    <!-- 商品列表：内容由 CartAdapter 提供，每行长相由 item_cart.xml 决定 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:clipToPadding="false" />

    <!-- 底部结算栏：全选(cbSelectAll) + 合计金额(tvCartTotal) + 去结算(btnCheckout) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/white"
        android:elevation="8dp">

        <CheckBox
            android:id="@+id/cbSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全选"
            android:textSize="14sp"
            android:textColor="#1F1F1F"
            android:background="@null"
            android:buttonTint="#F04142" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="合计："
            android:textSize="14sp"
            android:textColor="#8A8A8A"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tvCartTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥0.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#F04142"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnCheckout"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:text="去结算"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_auth_button"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
