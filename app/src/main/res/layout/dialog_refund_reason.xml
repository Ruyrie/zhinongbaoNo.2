<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_round_24"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="申请退款"
        android:textColor="#1F1F1F"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="退款申请提交后，卖家 24 小时内未处理将自动退款。"
        android:textColor="#8A8F8C"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:text="选择退款原因"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 第一行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipRefundReason1"
            style="@style/RefundReasonChip"
            android:layout_marginEnd="6dp"
            android:text="拍错/买错了" />

        <TextView
            android:id="@+id/chipRefundReason2"
            style="@style/RefundReasonChip"
            android:layout_marginStart="6dp"
            android:text="商品质量问题" />
    </LinearLayout>

    <!-- 第二行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipRefundReason3"
            style="@style/RefundReasonChip"
            android:layout_marginEnd="6dp"
            android:text="未收到货" />

        <TextView
            android:id="@+id/chipRefundReason4"
            style="@style/RefundReasonChip"
            android:layout_marginStart="6dp"
            android:text="不想要了" />
    </LinearLayout>

    <!-- 第三行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipRefundReason5"
            style="@style/RefundReasonChip"
            android:layout_marginEnd="6dp"
            android:text="价格/数量问题" />

        <TextView
            android:id="@+id/chipRefundReason6"
            style="@style/RefundReasonChip"
            android:layout_marginStart="6dp"
            android:text="其他" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:text="补充说明（选填）"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etRefundManual"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@drawable/bg_dialog_input"
        android:gravity="top|start"
        android:hint="可补充更详细的退款说明"
        android:padding="12dp"
        android:textColor="#1F1F1F"
        android:textColorHint="#AAB0B4"
        android:textSize="14sp"
        android:inputType="textMultiLine"
        android:maxLines="4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRefundCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_dialog_cancel"
            android:gravity="center"
            android:text="取消"
            android:textColor="#8A8A8A"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnRefundSubmit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_auth_button"
            android:gravity="center"
            android:text="提交申请"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
