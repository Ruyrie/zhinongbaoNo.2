<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="760dp"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="44dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/ivRegisterBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="42dp"
            android:padding="4dp"
            android:src="@mipmap/fanhui"
            android:contentDescription="返回" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginBottom="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/auth_logo"
                    android:contentDescription="支农宝" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="支农宝"
                    android:textColor="#111318"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="190dp"
                android:layout_height="138dp"
                android:layout_gravity="end|center_vertical"
                android:scaleType="fitEnd"
                android:src="@drawable/auth_register_hero"
                android:contentDescription="农产品插画" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="创建账号"
            android:textColor="#111318"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="28dp"
            android:text="加入支农宝，开启你的助农之旅"
            android:textColor="#303633"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_auth_input_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_auth_user" />

            <EditText
                android:id="@+id/etRegUsername"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="设置用户名"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#111318"
                android:textColorHint="#8F9692"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_auth_input_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_auth_phone" />

            <EditText
                android:id="@+id/etRegPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="手机号（可选）"
                android:inputType="phone"
                android:singleLine="true"
                android:textColor="#111318"
                android:textColorHint="#8F9692"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_auth_input_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_auth_lock" />

            <EditText
                android:id="@+id/etRegPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="设置密码（至少6位）"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#111318"
                android:textColorHint="#8F9692"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_auth_eye" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="选择注册角色"
            android:textColor="#111318"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbBuyer"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_role_card"
                android:button="@null"
                android:checked="true"
                android:drawableStart="@drawable/ic_role_buyer"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="买家\n购买农产品"
                android:textColor="#111318"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbSeller"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_role_card"
                android:button="@null"
                android:drawableStart="@drawable/ic_role_seller"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="卖家\n销售农产品"
                android:textColor="#111318"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RadioGroup>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_auth_green_button"
            android:stateListAnimator="@null"
            android:text="注册"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_auth_check" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="注册即表示同意"
                android:textColor="#737B76"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="《用户协议》"
                android:textColor="#24B34D"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 和 "
                android:textColor="#737B76"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="《隐私政策》"
                android:textColor="#24B34D"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
