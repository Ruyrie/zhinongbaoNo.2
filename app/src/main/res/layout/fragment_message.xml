<?xml version="1.0" encoding="utf-8"?>
<!--
 ============================================================
 【消息列表 / Message】布局（Fragment 界面布局）
 关键控件：rvConversations 会话列表；tvMsgEmpty 空状态提示（默认隐藏）。
 配合的文件：加载它的界面 fragment/MessageFragment；
   行布局 item_conversation.xml；适配器 adapter/ConversationAdapter。
 MVP 数据流位置：本文件是 View 层的静态界面描述，数据由 Presenter 填入。
 提示：在 IDE 里搜索「消息」可看本组相关文件。
 ============================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Title bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="消息"
        android:textSize="18sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#FFFFFF" />

    <!-- Conversation list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConversations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvMsgEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无消息"
        android:textSize="15sp"
        android:textColor="#AAAAAA"
        android:visibility="gone" />

</LinearLayout>
