<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7"
    android:fitsSystemWindows="true">

    <!-- ── Toolbar ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/tvBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/fanhui"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1F1F1F"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginEnd="8dp"
            android:text="" />

        <TextView
            android:id="@+id/tvDeleteBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_delete"
            android:textSize="15sp"
            android:textColor="#E53935"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ── Scrollable content ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cover image (hidden when no coverUri) -->
            <ImageView
                android:id="@+id/ivDetailCover"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:visibility="gone" />

            <!-- Article body (WebView) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white">

                <WebView
                    android:id="@+id/webViewContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- ── Comments section ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_marginTop="8dp">

                <!-- Header: "评论 N条" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_comment"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F" />

                    <TextView
                        android:id="@+id/tvCommentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#AAAAAA"
                        android:layout_marginStart="8dp"
                        android:text="@string/hint_comment_count" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="#F0F0F0" />

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/llNoComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="36dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/msg_no_comments"
                        android:textSize="14sp"
                        android:textColor="#BBBBBB" />
                </LinearLayout>

                <!-- Comments RecyclerView (nested scroll disabled) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <!-- Bottom padding so last comment isn't hidden under the bar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Fixed bottom action bar ── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:baselineAligned="false">

        <!-- Comment input (rounded pill, XHS style) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_bar"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="10dp">

            <EditText
                android:id="@+id/etComment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/hint_input_comment"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp"
                android:textColor="#1F1F1F"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:singleLine="true"
                android:autofillHints="no" />
        </LinearLayout>

        <!-- Like button (heart + count) -->
        <LinearLayout
            android:id="@+id/layoutLike"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="44dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/tvLikeBtn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/weidianzan"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_like" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:text="@string/default_count" />
        </LinearLayout>

        <!-- Comment count icon -->
        <LinearLayout
            android:id="@+id/layoutCommentIcon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="44dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/pinglun"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_comment_icon" />

            <TextView
                android:id="@+id/tvCommentCountBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:text="@string/default_count" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
