<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     【购物车 / Cart】购物车列表「单行」布局（item = 一行的样子）
     ============================================================
     这个文件是干什么的：
       它定义购物车列表里「一件商品那一行」长什么样：左边勾选框、
       商品图、右边名称+价格+数量加减按钮。整列由很多行重复而成。

     概念说明：
       - 文件名以 item_ 开头 = 列表里「单元格/一行」的布局。
       - LinearLayout：线性布局，android:orientation 决定子控件横排(horizontal)还是竖排(vertical)。
       - 每个控件的 android:id（如 @+id/cbCartItem）= 给控件取名字，
         Java 代码（CartAdapter）用 findViewById(R.id.cbCartItem) 找到它并填数据。
       - layout_weight="1" = 占满剩余空间（让中间区域自动撑开）。

     配套：被 CartAdapter 充气(inflate)使用；整页外框是 activity_cart.xml。
     提示：在 IDE 里搜索「购物车」可看本组全部文件。
     ============================================================ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/white"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:padding="12dp">

    <!-- 选择框 -->
    <CheckBox
        android:id="@+id/cbCartItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:background="@null"
        android:buttonTint="#F04142" />

    <!-- 商品图片占位 -->
    <ImageView
        android:id="@+id/ivCartImage"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_product_placeholder"
        android:background="#F5F5F5"
        android:layout_marginEnd="12dp" />

    <!-- 名称 + 价格 + 数量控制 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCartName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#1F1F1F"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="商品名" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvCartPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#F04142"
                android:text="¥0.00" />

            <!-- 数量控制 +/- -->
            <TextView
                android:id="@+id/btnMinus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="−"
                android:textSize="18sp"
                android:textColor="#1F1F1F"
                android:background="#F0F0F0" />

            <TextView
                android:id="@+id/tvCartQty"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1F1F1F"
                android:text="1" />

            <TextView
                android:id="@+id/btnPlus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="+"
                android:textSize="18sp"
                android:textColor="#1F1F1F"
                android:background="#F0F0F0" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
