<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:fitsSystemWindows="true">

    <!-- Toolbar（与发布商品保持一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <TextView
            android:id="@+id/ivPurchaseBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="20sp"
            android:textColor="#333333"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="采购市场"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center" />

        <!-- 右侧发布按钮 -->
        <TextView
            android:id="@+id/tvToolbarPost"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="发需求"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_auth_button"
            android:backgroundTint="#E53935"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPurchaseRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <!-- 空状态（叠加在列表上，visibility 控制） -->
    <TextView
        android:id="@+id/tvPurchaseEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="暂无采购需求\n快来发布第一条采购需求吧"
        android:textSize="15sp"
        android:textColor="#BBBBBB"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:visibility="gone" />

</LinearLayout>
