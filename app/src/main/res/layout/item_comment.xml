<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="@color/white">

    <!-- Author avatar circle -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="2dp"
        app:cardCornerRadius="19dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivCommentAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_auth_logo"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCommentAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_auth_logo" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Comment body -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <!-- Username row: name | like | delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCommentUsername"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1F1F1F"
                android:text="用户名" />

            <!-- Like (left of delete) -->
            <LinearLayout
                android:id="@+id/layoutCommentLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="6dp"
                android:background="@null">

                <ImageView
                    android:id="@+id/tvCommentLikeBtn"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@mipmap/weidianzan"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvCommentLikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginStart="3dp"
                    android:text="0" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeleteComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingVertical="4dp"
                android:background="@null"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Comment text -->
        <TextView
            android:id="@+id/tvCommentContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#333333"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginTop="4dp"
            android:text="评论内容" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvCommentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginTop="5dp"
            android:text="时间" />
    </LinearLayout>

</LinearLayout>
