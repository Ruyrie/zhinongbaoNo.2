<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/tvBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/fanhui"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="返回"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="添加商品"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1F1F1F"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnSubmitProduct"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:text="添加"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_add_product_submit"
            android:gravity="center" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="14dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="商品图片"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="最多上传 9 张，建议首图清晰展示商品"
                        android:textSize="12sp"
                        android:textColor="#8A8A8A" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvProductImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="104dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_add_product_image_panel"
                        android:padding="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="基础信息"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F" />

                    <EditText
                        android:id="@+id/etProductName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:hint="商品名称（必填）"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:textColorHint="#B8B8B8"
                        android:background="@drawable/bg_add_product_input"
                        android:inputType="text"
                        android:maxLines="2"
                        android:paddingHorizontal="14dp" />

                    <EditText
                        android:id="@+id/etProductDesc"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="12dp"
                        android:hint="商品介绍（产地、规格、特点...）（必填）"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:textColorHint="#B8B8B8"
                        android:background="@drawable/bg_add_product_input"
                        android:inputType="textMultiLine"
                        android:gravity="top"
                        android:padding="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="价格与联系方式"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_add_product_price"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¥"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#E53935"
                            android:layout_marginEnd="6dp" />

                        <EditText
                            android:id="@+id/etProductPrice"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="0.00（必填）"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#E53935"
                            android:textColorHint="#E3B7B4"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:singleLine="true"
                            android:inputType="numberDecimal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="元"
                            android:textSize="15sp"
                            android:textColor="#B07A77"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etStorePhone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:hint="商铺电话号码（买家可拨打联系）（必填）"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:textColorHint="#B8B8B8"
                        android:background="@drawable/bg_add_product_input"
                        android:inputType="phone"
                        android:paddingHorizontal="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="商品参数"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F" />

                    <EditText
                        android:id="@+id/etProductBrand"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:hint="品牌（如：北货郎、自营农场）（必填）"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:textColorHint="#B8B8B8"
                        android:background="@drawable/bg_add_product_input"
                        android:singleLine="true"
                        android:paddingHorizontal="14dp" />

                    <EditText
                        android:id="@+id/etProductOrigin"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:hint="产地（如：山东临沂、东北产区）（必填）"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:textColorHint="#B8B8B8"
                        android:background="@drawable/bg_add_product_input"
                        android:singleLine="true"
                        android:paddingHorizontal="14dp" />

                    <EditText
                        android:id="@+id/etProductSpec"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:hint="规格（如：500g/盒、5kg/袋）（必填）"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:textColorHint="#B8B8B8"
                        android:background="@drawable/bg_add_product_input"
                        android:singleLine="true"
                        android:paddingHorizontal="14dp" />

                    <EditText
                        android:id="@+id/etProductPackage"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:hint="包装方式（如：礼盒装、袋装、散装）（必填）"
                        android:textSize="15sp"
                        android:textColor="#333333"
                        android:textColorHint="#B8B8B8"
                        android:background="@drawable/bg_add_product_input"
                        android:singleLine="true"
                        android:paddingHorizontal="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="选择分类"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1F1F1F" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="可多选，方便买家筛选"
                        android:textSize="12sp"
                        android:textColor="#8A8A8A" />

                    <LinearLayout
                        android:id="@+id/llCategoryPicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
