<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:fitsSystemWindows="true">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="20sp"
            android:textColor="#333333"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="添加商品"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnSubmitProduct"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="添加"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_auth_button"
            android:backgroundTint="#E53935"
            android:gravity="center"
            android:paddingHorizontal="20dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cover image picker area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="商品图片 (最多9张)"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProductImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp" />
                
            </LinearLayout>

            <!-- Product name -->
            <EditText
                android:id="@+id/etProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="商品名称"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:textColorHint="#BBBBBB"
                android:background="@null"
                android:inputType="text"
                android:maxLines="2"
                android:padding="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginHorizontal="16dp" />

            <!-- Product description -->
            <EditText
                android:id="@+id/etProductDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="180dp"
                android:hint="商品介绍（产地、规格、特点…）"
                android:textSize="16sp"
                android:textColor="#333333"
                android:textColorHint="#BBBBBB"
                android:background="@null"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:padding="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginHorizontal="16dp" />

            <!-- Price row with ¥ prefix -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#F04142"
                    android:layout_marginEnd="2dp" />

                <EditText
                    android:id="@+id/etProductPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="0.00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#F04142"
                    android:textColorHint="#DDBBBB"
                    android:background="@null"
                    android:inputType="numberDecimal"
                    android:padding="12dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginHorizontal="16dp" />

            <EditText
                android:id="@+id/etStorePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="商铺电话号码（买家可拨打联系）"
                android:textSize="16sp"
                android:textColor="#333333"
                android:textColorHint="#BBBBBB"
                android:background="@null"
                android:inputType="phone"
                android:padding="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginHorizontal="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="商品参数"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etProductBrand"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="品牌（如：北货郎、自营农场）"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textColorHint="#BBBBBB"
                    android:background="@null"
                    android:singleLine="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <EditText
                    android:id="@+id/etProductOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="产地（如：山东临沂、东北产区）"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textColorHint="#BBBBBB"
                    android:background="@null"
                    android:singleLine="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <EditText
                    android:id="@+id/etProductSpec"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="规格（如：500g/盒、5kg/袋）"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textColorHint="#BBBBBB"
                    android:background="@null"
                    android:singleLine="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />

                <EditText
                    android:id="@+id/etProductPackage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="包装方式（如：礼盒装、袋装、散装）"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:textColorHint="#BBBBBB"
                    android:background="@null"
                    android:singleLine="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginHorizontal="16dp" />

            <!-- Category picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择分类 (可多选)"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/llCategoryPicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
