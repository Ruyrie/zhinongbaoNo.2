<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/white"
        android:fitsSystemWindows="true"
        android:elevation="2dp">
        <ImageView
            android:id="@+id/tvBack"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/fanhui"
            android:scaleType="fitCenter"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1F1F1F" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- 分组1：账号 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="账号"
                android:textSize="13sp"
                android:textColor="#8A8A8A"
                android:paddingHorizontal="20dp"
                android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/tvAccountManager"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@mipmap/zhanghaoguanli" android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="账号管理"
                    android:textSize="16sp" android:textColor="#1F1F1F"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="#C7C7CC"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="#E5E5EA" android:layout_marginStart="52dp"/>

            <LinearLayout
                android:id="@+id/tvAddressManager"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="?android:attr/selectableItemBackground">
                <ImageView
                    android:id="@+id/ivAddressManagerIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="地址管理"
                    android:textSize="16sp" android:textColor="#1F1F1F"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="#C7C7CC"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 分组2：内容发布 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="内容发布"
            android:textSize="13sp"
            android:textColor="#8A8A8A"
            android:paddingHorizontal="20dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/tvAddArticle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@mipmap/tianjiawenzhang" android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="发布文章"
                    android:textSize="16sp" android:textColor="#1F1F1F"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="#C7C7CC"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="#E5E5EA" android:layout_marginStart="52dp"/>

            <LinearLayout
                android:id="@+id/tvAddProduct"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@mipmap/tianjiashangpin" android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="发布商品"
                    android:textSize="16sp" android:textColor="#1F1F1F"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="#C7C7CC"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 分组3：关于 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="关于"
            android:textSize="13sp"
            android:textColor="#8A8A8A"
            android:paddingHorizontal="20dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/tvAboutUs"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/zhinongbaoicon" android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="关于我们"
                    android:textSize="16sp" android:textColor="#1F1F1F"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="22sp" android:textColor="#C7C7CC"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 分组3：退出登录（危险区） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/tvLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:background="?android:attr/selectableItemBackground">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@mipmap/tuchudenglu" android:layout_marginEnd="14dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="退出登录"
                    android:textSize="16sp" android:textColor="#FF3B30"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    </ScrollView>
</LinearLayout>
