<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <!-- ── iOS-style search bar row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:background="@color/white">

        <!-- Rounded gray search field (iOS UISearchBar style) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_input"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@mipmap/sousuo"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索"
                android:textColorHint="#8E8E93"
                android:textSize="15sp"
                android:textColor="#1C1C1E"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />

            <!-- Clear ✕ button (visible when text is non-empty) -->
            <TextView
                android:id="@+id/tvClearSearch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:text="✕"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/bg_auth_logo"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Always-visible Cancel button (iOS UX) -->
        <TextView
            android:id="@+id/tvSearchCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:textSize="16sp"
            android:textColor="#2F80ED"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />
    </LinearLayout>

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#C6C6C8" />

    <!-- ── Content area (changes between initial / results / no-results) ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Initial state: hot-topic chips -->
        <LinearLayout
            android:id="@+id/llSearchHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="热门话题"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#8E8E93"
                android:letterSpacing="0.05"
                android:layout_marginBottom="14dp" />

            <!-- Chip row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView android:id="@+id/tagRice"   style="@style/SearchTagChip" android:text="水稻育种" />
                <TextView android:id="@+id/tagSmart"  style="@style/SearchTagChip" android:text="智慧农业" />
                <TextView android:id="@+id/tagRural"  style="@style/SearchTagChip" android:text="乡村振兴" />
            </LinearLayout>

            <!-- Chip row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/tagEco"     style="@style/SearchTagChip" android:text="农业经济" />
                <TextView android:id="@+id/tagTech"    style="@style/SearchTagChip" android:text="科技节" />
                <TextView android:id="@+id/tagOrganic" style="@style/SearchTagChip" android:text="有机农业" />
            </LinearLayout>
        </LinearLayout>

        <!-- Search results -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- No results state -->
        <LinearLayout
            android:id="@+id/llNoResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@mipmap/sousuo"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvNoResultsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#8E8E93"
                android:text="未找到相关内容" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>

