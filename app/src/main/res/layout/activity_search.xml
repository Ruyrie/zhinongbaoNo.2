<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <!-- ── iOS-style search bar row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:background="@color/white">

        <!-- Rounded gray search field (iOS UISearchBar style) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_input"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@mipmap/sousuo"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索"
                android:textColorHint="#8E8E93"
                android:textSize="15sp"
                android:textColor="#1C1C1E"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />

            <!-- Clear ✕ button (visible when text is non-empty) -->
            <TextView
                android:id="@+id/tvClearSearch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:text="✕"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/bg_auth_logo"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Always-visible Cancel button (iOS UX) -->
        <TextView
            android:id="@+id/tvSearchCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:textSize="16sp"
            android:textColor="#2F80ED"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />
    </LinearLayout>

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#C6C6C8" />

    <!-- ── Content area (changes between initial / results / no-results) ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Initial state: hot-topic chips -->
        <LinearLayout
            android:id="@+id/llSearchHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="热门话题"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111318" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:text="精选可阅读专题，点击即可查看相关文章"
                android:textColor="#737B76"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tagSpring"
                    style="@style/SearchTopicCard"
                    android:layout_marginEnd="10dp"
                    android:text="春耕管理\n播种、施肥、病虫害" />

                <TextView
                    android:id="@+id/tagFruit"
                    style="@style/SearchTopicCard"
                    android:text="果树花期\n授粉、防寒、疏果" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tagFresh"
                    style="@style/SearchTopicCard"
                    android:layout_marginEnd="10dp"
                    android:text="保鲜运输\n预冷、包装、减损" />

                <TextView
                    android:id="@+id/tagStartup"
                    style="@style/SearchTopicCard"
                    android:text="返乡创业\n项目选择、市场调研" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tagPlatform"
                    style="@style/SearchTopicCard"
                    android:layout_marginEnd="10dp"
                    android:text="支农宝动态\n平台、产销、服务" />

                <TextView
                    android:id="@+id/tagMarket"
                    style="@style/SearchTopicCard"
                    android:text="农产品上行\n展示、采购、销售" />
            </LinearLayout>
        </LinearLayout>

        <!-- Search results -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- No results state -->
        <LinearLayout
            android:id="@+id/llNoResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@mipmap/sousuo"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvNoResultsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#8E8E93"
                android:text="未找到相关内容" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>

