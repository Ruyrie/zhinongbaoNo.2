<?xml version="1.0" encoding="utf-8"?>
<!--
 ============================================================
 【聊天对话 / Chat】布局（Activity 界面布局）
 关键控件：ivChatBack 返回；tvChatTitle 标题；rvChatMessages 消息列表；
   etChatInput 输入框；btnChatSend 发送；btnChatMore 更多；llChatMorePanel 更多面板；
   btnChatCamera 拍照；btnChatAlbum 相册。
 配合的文件：加载它的界面 activity/ChatActivity；气泡行布局
   item_chat_sent/received/recalled.xml；适配器 adapter/ChatAdapter。
 MVP 数据流位置：本文件是 View 层的静态界面描述，数据由 Presenter 填入。
 提示：在 IDE 里搜索「聊天」可看本组相关文件。
 ============================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7"
    android:fitsSystemWindows="true">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/ivChatBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/fanhui"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1F1F1F"
            android:gravity="center"
            android:text="客服"
            android:layout_marginEnd="48dp" />
    </LinearLayout>

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="8dp"
        android:clipToPadding="false" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#DDDDDD" />

    <!-- Input bar -->
    <LinearLayout
        android:id="@+id/llChatInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:padding="8dp">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入消息..."
            android:textSize="15sp"
            android:textColor="#1F1F1F"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnChatMore"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_chat_more_button"
            android:gravity="center"
            android:text="+"
            android:textColor="#333333"
            android:textSize="28sp"
            android:clickable="true"
            android:focusable="true" />

        <Button
            android:id="@+id/btnChatSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="#4CAF50"
            android:paddingHorizontal="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llChatMorePanel"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/btnChatCamera"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chat_more_tile"
                android:padding="12dp"
                android:src="@drawable/ic_chat_camera"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="拍照"
                android:textColor="#333333"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnChatAlbum"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chat_more_tile"
                android:padding="12dp"
                android:src="@drawable/ic_chat_photo"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="照片"
                android:textColor="#333333"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
