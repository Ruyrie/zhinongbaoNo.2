<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_margin="12dp"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- 品类标签 + 发布者 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvReqCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_category_tag"
            android:textColor="#1976D2"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/tvReqBuyer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#AAAAAA" />
    </LinearLayout>

    <!-- 货品名称 -->
    <TextView
        android:id="@+id/tvReqProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="6dp" />

    <!-- 数量 + 目标价格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="需求量："
            android:textSize="13sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvReqQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#333333"
            android:textStyle="bold" />

        <View android:layout_width="20dp" android:layout_height="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="目标价："
            android:textSize="13sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvReqTargetPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#E53935"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 描述 -->
    <TextView
        android:id="@+id/tvReqDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#666666"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="10dp" />

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="10dp" />

    <!-- 底部：报价数 + 时间 + 操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvReqQuoteCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#1976D2" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/tvReqTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/btnReqQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我要报价"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_auth_button"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnViewQuotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看报价"
            android:textSize="13sp"
            android:textColor="#1976D2"
            android:background="@drawable/bg_bubble_received"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
