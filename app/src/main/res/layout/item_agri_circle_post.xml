<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- ── 用户信息行 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- 头像 -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/ivPostAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_auth_logo"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPostAvatarInitial"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_auth_logo" />
        </FrameLayout>

        <!-- 昵称 + 日期 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tvPostNickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

            <TextView
                android:id="@+id/tvPostTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 进店铺 -->
        <TextView
            android:id="@+id/btnEnterStore"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="进店铺"
            android:textSize="12sp"
            android:textColor="#4CAF50"
            android:background="@drawable/bg_circle_btn"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <!-- +关注 -->
        <TextView
            android:id="@+id/btnFollow"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="+关注"
            android:textSize="12sp"
            android:textColor="#4CAF50"
            android:background="@drawable/bg_circle_btn"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:layout_marginStart="6dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ── 正文 ── -->
    <TextView
        android:id="@+id/tvPostContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="#333333"
        android:lineSpacingMultiplier="1.4"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp" />

    <!-- ── 图片（可选，全宽） ── -->
    <ImageView
        android:id="@+id/ivPostCover"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:visibility="gone"
        android:layout_marginBottom="10dp" />

    <!-- ── 分割线 ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#EEEEEE" />

    <!-- ── 点赞 / 评论 行 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- 点赞 -->
        <LinearLayout
            android:id="@+id/btnPostLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivLikeIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_like_outline"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- 评论 -->
        <LinearLayout
            android:id="@+id/btnPostComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
