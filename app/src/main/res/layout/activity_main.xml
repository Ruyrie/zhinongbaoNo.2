<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Fragment 容器（内容延伸到底部全屏，让玻璃栏真正悬浮在上面） -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 液态玻璃底部导航栏 -->
    <FrameLayout
        android:id="@+id/glassNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp"
        android:paddingTop="12dp"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 白色底框 (纯白背景 + 悬浮阴影) -->
        <com.example.zhinongbao.view.RoundedClipFrame
            android:id="@+id/glassNavClip"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:elevation="0dp"
            app:cornerRadius="34dp">

            <!-- 实时模糊背后的内容(可选，用户要求纯色，所以隐藏) -->
            <com.example.zhinongbao.view.BlurBehindView
                android:id="@+id/navBlur"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- 白色背景层 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_nav" />
        </com.example.zhinongbao.view.RoundedClipFrame>

        <!-- 滑动液态药丸：被抽离出裁剪框，使其能在高度上自由膨胀变胖 -->
        <com.example.zhinongbao.view.RoundedClipFrame
            android:id="@+id/glassPill"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:elevation="0dp"
            app:cornerRadius="28dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_pill" />
        </com.example.zhinongbao.view.RoundedClipFrame>

        <!-- 五个 tab (提升 elevation，使其在背景和药丸之上) -->
        <LinearLayout
            android:id="@+id/glassTabBar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:elevation="0dp"
            android:weightSum="5">

                <LinearLayout
                    android:id="@+id/tabHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/ripple_transparent">

                    <ImageView
                        android:id="@+id/iconHome"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_headline"
                        app:tint="#2F80ED" />

                    <TextView
                        android:id="@+id/labelHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="首页"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#2F80ED"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabSecond"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/ripple_transparent">

                    <ImageView
                        android:id="@+id/iconSecond"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_mall"
                        app:tint="#1F1F1F" />

                    <TextView
                        android:id="@+id/labelSecond"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="农技学堂"
                        android:textSize="11sp"
                        android:textColor="#1F1F1F"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabPublish"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/ripple_transparent">

                    <ImageView
                        android:id="@+id/iconPublish"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_mall"
                        app:tint="#1F1F1F" />

                    <TextView
                        android:id="@+id/labelPublish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="发布"
                        android:textSize="11sp"
                        android:textColor="#1F1F1F"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabMessage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:background="@drawable/ripple_transparent">

                    <!-- 图标 + 右上角未读红点 -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <ImageView
                            android:id="@+id/iconMessage"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_nav_mall"
                            app:tint="#1F1F1F" />

                        <TextView
                            android:id="@+id/tvMsgBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="-6dp"
                            android:layout_marginEnd="-10dp"
                            android:minWidth="16dp"
                            android:gravity="center"
                            android:paddingHorizontal="4dp"
                            android:background="@drawable/bg_nav_badge"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/labelMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="消息"
                        android:textSize="11sp"
                        android:textColor="#1F1F1F"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabMine"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/ripple_transparent">

                    <ImageView
                        android:id="@+id/iconMine"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_mine"
                        app:tint="#1F1F1F" />

                    <TextView
                        android:id="@+id/labelMine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="我的"
                        android:textSize="11sp"
                        android:textColor="#1F1F1F"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
