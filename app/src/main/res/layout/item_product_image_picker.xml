<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    【图片选择格 / item_product_image_picker】布局（列表项）
    配合的文件：由 ImagePickerAdapter 在多图上传的 RecyclerView 中逐格加载。
    在 MVP 数据流中的位置：View 的界面资源（列表项），不含任何业务逻辑。
    提示：在 IDE 里搜索「图片选择适配器」可看本组相关文件。
    ============================================================
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="100dp"
    android:layout_height="100dp"
    android:layout_margin="4dp">

    <ImageView
        android:id="@+id/ivPickerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#EDEDEF" />

    <ImageView
        android:id="@+id/ivDeleteImage"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="@drawable/bg_glass_pill"
        android:padding="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/llAddPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5F5F5"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textSize="32sp"
            android:textColor="#AAAAAA" />
    </LinearLayout>

</FrameLayout>
