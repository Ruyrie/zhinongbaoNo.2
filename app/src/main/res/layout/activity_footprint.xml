<?xml version="1.0" encoding="utf-8"?>
<!--
    ============================================================
    【我的足迹 / Footprint】布局（Activity 界面）
    整体结构：顶部返回栏 + 标题 + 两个筛选标签 + 网格列表 + 空视图。
    配合的文件：由 FootprintActivity 加载；列表内各行视图在代码中动态构建，
      不使用单独 item 布局。
    在 MVP 数据流中的位置：View 的界面资源，不含任何业务逻辑。
    提示：在 IDE 里搜索「我的足迹」可看本组相关文件。
    ============================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F2F7"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/tvFootprintBack"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/fanhui"
            android:scaleType="fitCenter"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvFootprintTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="我的足迹 (0)"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1F1F1F"
            android:gravity="center"
            android:layout_marginEnd="36dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/tabFootprintProducts"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="商品"
            android:textColor="#1F1F1F"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginEnd="36dp" />

        <TextView
            android:id="@+id/tabFootprintStores"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="店铺"
            android:textColor="#8A8A8A"
            android:textSize="17sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFootprints"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tvFootprintEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无浏览记录"
        android:textSize="15sp"
        android:textColor="#8A8A8A"
        android:visibility="gone" />

</LinearLayout>
