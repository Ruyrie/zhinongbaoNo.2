<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/tvBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/fanhui"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="商品详情"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginEnd="38dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <!-- 商品图片轮播 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpProductImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- 轮播指示器 (1/5) -->
                <TextView
                    android:id="@+id/tvImageIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_glass_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="1/1"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvDetailProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textColor="#E53935"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:text="¥0.00" />

                <TextView
                    android:id="@+id/tvDetailProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp"
                    android:text="商品名称" />

                <TextView
                    android:id="@+id/tvDetailProductDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="#666666"
                    android:text="商品介绍" />

            </LinearLayout>

            <!-- 服务保障模块 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保障"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="假一赔四 · 退货包运费 · 极速退款 · 7天无理由退换"
                    android:textSize="13sp"
                    android:textColor="#333333"/>
            </LinearLayout>

            <!-- 规格参数模块 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:background="@color/white"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="参数"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="品牌 产地 包装方式..."
                    android:textSize="13sp"
                    android:textColor="#333333"/>
            </LinearLayout>

            <!-- 用户评价模块 -->
            <LinearLayout
                android:id="@+id/llCommentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="16dp"
                android:foreground="?attr/selectableItemBackground">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tvCommentCountTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="商品评价 (0)"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="查看全部评价 ›"
                        android:textSize="13sp"
                        android:textColor="#999999"/>
                </LinearLayout>

                <!-- 单个评价示例 (动态绑定) -->
                <LinearLayout
                    android:id="@+id/llLatestComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/ivCommentAvatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_launcher_background"
                        android:background="@drawable/bg_glass_pill"
                        android:scaleType="centerCrop" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:id="@+id/tvCommentUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="匿名用户"
                            android:textSize="13sp"
                            android:textColor="#666666"/>
                        <TextView
                            android:id="@+id/tvCommentContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="东西非常不错，包装很严实，发货速度也很快，值得推荐购买！"
                            android:textSize="14sp"
                            android:textColor="#333333"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 图文详情模块 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—— 图文详情 ——"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:paddingVertical="16dp"/>
                
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDetailImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
                
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@android:color/white"
        android:elevation="4dp">

        <!-- 联系客服图标 -->
        <ImageView
            android:id="@+id/ivContactService"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginEnd="4dp" />

        <!-- 购物车图标 -->
        <ImageView
            android:id="@+id/ivCartIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/gouwuche"
            android:scaleType="fitCenter"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnAddCart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="加入购物车"
            android:backgroundTint="#FF9800"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnBuy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="立即购买"
            android:backgroundTint="#E53935" />

    </LinearLayout>
</LinearLayout>

