<?xml version="1.0" encoding="utf-8"?>
<!--
 ============================================================
 【消息列表-会话行 / Conversation】布局（列表项布局）
 关键控件：tvConvAvatar 头像；tvConvName 昵称；tvConvTime 时间；
   tvConvLastMsg 最后消息；tvConvUnread 未读红点（默认隐藏）。
 配合的文件：适配器 adapter/ConversationAdapter（在这里 findViewById 并填数据）；
   数据模型 model/ConversationItem；使用页面 fragment/MessageFragment。
 MVP 数据流位置：本文件是 View 层的静态行模板，数据由适配器填入。
 提示：在 IDE 里搜索「消息」可看本组相关文件。
 ============================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Avatar initial circle -->
    <TextView
        android:id="@+id/tvConvAvatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_auth_logo"
        android:gravity="center"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <!-- Name + last message -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvConvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F1F1F"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvConvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#AAAAAA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvConvLastMsg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="#888888"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Unread badge -->
            <TextView
                android:id="@+id/tvConvUnread"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_unread_badge"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
